# Copy to .env and adjust. Values below are for local development only.
# docker compose: the API reaches Postgres at host "db". Running uvicorn on the host: use localhost.
DATABASE_URL=postgresql+asyncpg://drive:drive@db:5432/drive
JWT_SECRET=change-me-to-at-least-32-random-bytes-0123456789abcdef
ACCESS_TOKEN_TTL_MIN=15
REFRESH_TOKEN_TTL_DAYS=30
# Must match the car app's BuildConfig.CAR_PROVISIONING_KEY (debug default: dev-provisioning-key)
CAR_PROVISIONING_KEY=dev-provisioning-key
MAX_DRIVERS_PER_CAR=8
MIN_MINUTES_DAY=10
MIN_MINUTES_WEEK=45
MIN_MINUTES_MONTH=120
MIN_MINUTES_YEAR=480
MIN_MINUTES_ALL=480
LEADERBOARD_CACHE_TTL_S=60
CORS_ORIGINS=
LOG_LEVEL=INFO
ENV=dev
